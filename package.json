{
  "name": "mollie-ecommerce",
  "version": "0.4.0",
  "description": "A SKU, order and delivery lifecycle layer over Mollie \u2014 the minimum an ecommerce flow needs.",
  "keywords": [
    "mollie",
    "ecommerce",
    "payments",
    "checkout",
    "refund",
    "orders",
    "sku",
    "variants",
    "inventory",
    "fulfillment",
    "bun",
    "typescript"
  ],
  "license": "MIT",
  "homepage": "https://github.com/alexandre-dos-reis/mollie-ecommerce#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alexandre-dos-reis/mollie-ecommerce.git"
  },
  "bugs": {
    "url": "https://github.com/alexandre-dos-reis/mollie-ecommerce/issues"
  },
  "type": "module",
  "sideEffects": false,
  "module": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./conformance": "./src/conformance.ts"
  },
  "files": [
    "src",
    "!src/**/*.test.ts",
    "examples/memory-storage.ts",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "bun": ">=1.2.0"
  },
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "check": "bun run typecheck && bun test",
    "example": "bun run examples/quickstart.ts"
  },
  "dependencies": {
    "mollie-api-typescript": "^1.12.44"
  },
  "peerDependencies": {
    "typescript": ">=5.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.15",
    "@types/bun": "latest",
    "@types/pg": "^8.23.1",
    "pg": "^8.23.1",
    "typescript": "7.0.2"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  }
}
