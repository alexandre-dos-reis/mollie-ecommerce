{
  "name": "mollie-ecommerce",
  "version": "0.5.0",
  "description": "A SKU, order and delivery lifecycle layer over Mollie \u2014 the minimum an ecommerce flow needs.",
  "keywords": [
    "mollie",
    "ecommerce",
    "payments",
    "checkout",
    "refund",
    "orders",
    "sku",
    "variants",
    "inventory",
    "fulfillment",
    "bun",
    "typescript"
  ],
  "license": "MIT",
  "homepage": "https://github.com/alexandre-dos-reis/mollie-ecommerce#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alexandre-dos-reis/mollie-ecommerce.git"
  },
  "bugs": {
    "url": "https://github.com/alexandre-dos-reis/mollie-ecommerce/issues"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./conformance": {
      "types": "./dist/conformance.d.ts",
      "default": "./dist/conformance.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "check": "bun run typecheck && bun test",
    "build": "tsdown",
    "example": "bun run examples/quickstart.ts",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "bun run check && changeset publish",
    "prepublishOnly": "bun run check && bun run build"
  },
  "dependencies": {
    "mollie-api-typescript": "^1.12.44",
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "typescript": ">=5.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.15",
    "@types/bun": "latest",
    "@types/pg": "^8.23.1",
    "pg": "^8.23.1",
    "tsdown": "^0.23.5",
    "typescript": "7.0.2"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts"
}
